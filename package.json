{
    "name": "discord-auction-bot",
    "version": "1.0.0",
    "description": "Discord bot for running multi-round player auctions.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tests.json",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,js,md}\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,js,md}\" \".github/**/*.yml\"",
        "test": "tsx --test tests/*.test.ts",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
        "prestart": "pnpm run build",
        "start": "node dist/index.js",
        "deploy:commands": "tsx src/deploy-commands.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=20.20.1"
    },
    "packageManager": "pnpm@10.29.2",
    "dependencies": {
        "discord.js": "^14.25.1",
        "dotenv": "^17.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.3.3",
        "eslint": "^10.0.2",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1"
    }
}
